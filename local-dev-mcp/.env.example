# Copy to .env or set these in your MCP client's "env" block.
# All variables are optional; defaults are shown.

# Restrict filesystem access to these roots (os.pathsep-separated).
# Leave empty for unrestricted access (Claude Code-style).
# LOCAL_DEV_MCP_ROOTS=/home/me/projects:/tmp

# Capability switches (true/false).
LOCAL_DEV_MCP_ALLOW_WRITE=true
LOCAL_DEV_MCP_ALLOW_DELETE=true
LOCAL_DEV_MCP_ALLOW_TERMINAL=true
LOCAL_DEV_MCP_ALLOW_NETWORK=true
LOCAL_DEV_MCP_ALLOW_GUI=true
LOCAL_DEV_MCP_ALLOW_DATABASE=true

# Limits.
LOCAL_DEV_MCP_COMMAND_TIMEOUT=120
LOCAL_DEV_MCP_MAX_OUTPUT_BYTES=200000
LOCAL_DEV_MCP_MAX_READ_BYTES=2000000
LOCAL_DEV_MCP_TREE_MAX_ENTRIES=5000

# Default working directory for terminal commands (defaults to CWD).
# LOCAL_DEV_MCP_DEFAULT_CWD=/home/me/projects

# Logging: DEBUG / INFO / WARNING / ERROR.
LOCAL_DEV_MCP_LOG_LEVEL=INFO
