# Copy to .env or set these in your MCP client's "env" block.
# All variables are optional; defaults are shown.

# Restrict filesystem access to these roots (os.pathsep-separated).
# Leave empty for unrestricted access (Claude Code-style).
# LOCAL_DEV_MCP_ROOTS=/home/me/projects:/tmp

# Alternatively (or in addition), keep the allow-list in a file on disk, one
# directory per line ('#' starts a comment). A file at
#   ~/.local-dev-mcp/allowed_roots.txt   (Windows: C:\Users\<you>\.local-dev-mcp\allowed_roots.txt)
# is loaded automatically. You can also point to a custom file:
# LOCAL_DEV_MCP_ROOTS_FILE=/path/to/allowed_roots.txt

# Capability switches (true/false).
LOCAL_DEV_MCP_ALLOW_WRITE=true
LOCAL_DEV_MCP_ALLOW_DELETE=true
LOCAL_DEV_MCP_ALLOW_TERMINAL=true
LOCAL_DEV_MCP_ALLOW_NETWORK=true
LOCAL_DEV_MCP_ALLOW_GUI=true
LOCAL_DEV_MCP_ALLOW_DATABASE=true

# Limits.
LOCAL_DEV_MCP_COMMAND_TIMEOUT=120
LOCAL_DEV_MCP_MAX_OUTPUT_BYTES=200000
LOCAL_DEV_MCP_MAX_READ_BYTES=2000000
LOCAL_DEV_MCP_TREE_MAX_ENTRIES=5000

# Default working directory for terminal commands (defaults to CWD).
# LOCAL_DEV_MCP_DEFAULT_CWD=/home/me/projects

# Shared-secret token for the network transports (HTTP/SSE). STRONGLY
# recommended before exposing the server through a tunnel. When set, every
# request must send it as `Authorization: Bearer <token>` or `X-API-Key: <token>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# LOCAL_DEV_MCP_AUTH_TOKEN=replace-with-a-long-random-string

# DNS-rebinding protection: comma-separated Host header allow-list. Leave empty
# to disable host validation (required to work behind a tunnel like cloudflared;
# the auth token is then the gate). Set it to pin specific hosts, e.g.:
# LOCAL_DEV_MCP_ALLOWED_HOSTS=myname.trycloudflare.com,localhost:8000

# Logging: DEBUG / INFO / WARNING / ERROR.
LOCAL_DEV_MCP_LOG_LEVEL=INFO
